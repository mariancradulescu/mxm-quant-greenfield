  "exact_hard_laws": {
    "EUR200": "Existing classifier, no relaxation. Required bidirectional mode=0 and shortability, min/step/lot>0, max>=min, min%step=0, explicit units and bound expected margin. max(buy_min_margin_eur,sell_min_margin_eur)>=200 => structurally infeasible; <200 is necessary minimum-position feasibility only.",
    "integrity": "Exact encrypted/plaintext SHA256; existing raw package keys, M5 open timestamps aligned to300seconds, increasing and unique; zero out-of-segment or protected-forward rows; exact row counts and range plus manifest first/last; finite canonical OHLC obey low<=open,close<=high; canonical integer tick volume>=0. No imputation, repair or reordering.",
    "master": "Exact hash-bound 1576 roster, original order, no substitution; segments 1..4, shards 0..24. Shards are transport units, not scientific cohorts.",
    "metadata": "Reexecute byte-identical accepted quote_scope_metadata_v1.classify with accepted identity/light/full/exact minimum-volume-margin metadata and EUR deposit. Required explicit commission, conversion and schedule fields remain the classifier completeness requirements; no new historical spread/slippage requirement.",
    "support": ">=1 authentic M5 row in the whole shallow window; pre_capture /post_capture_support_law/complete. This is existence only, never power, activity, profitability or edge. No minimum rows per segment."
  },
