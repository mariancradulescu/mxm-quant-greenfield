  "historical_CI": "Preserve previous runs and validators unchanged; obsolete ARM-absence/old change-allowlist failures do not change this scientific result.",
  "implementation": {
    "activity": "Counts, observed gaps, days and UTC weekday/hour distribution only. Nonzero ratio descriptive; no cutoff, percentile or activity selection.",
    "fail_closed": "Any asset/plaintext hash or identity/segment/row contradiction aborts; no partial-result selection, no raw exception values.",
    "late_start_input": "Future evidence must be separately authorized and hash-bound; base real loader uses none, not inferred.",
    "output_schema_ref": "research_core_v4/master1576_screen_v2.py: RESULT_FIELDS, IDENTITY_FIELDS, REASON_FIELDS, GAP_FIELDS",
    "private_route": "Existing MXM_V4_INPUT_BUNDLE_PRIVATE_KEY_PEM, wrapped AES passphrase format preserved; no key or cTrader secret requested in preflight. Temporary files restricted and removed on both success/failure. Python immutable memory is dereferenced, not claimed cryptographically zeroized.",
    "raw_OHLC": "Transient integrity only; never persisted, printed or used to compute returns/ranking.",
    "real_authorization": "Separate future hash-bound ARM required; no real ARM created. One durable attempt lock, no automatic retries, no existing result overwrite. No real-execution workflow added.",
    "role": "Deterministic machine-side decrypt/verify/structural summary, one expected asset at a time; no real execution now.",
    "sequence": [
      "Validate separate exact-hash ARM and branch",
      "Validate accepted authority, V2 and all100 asset bindings",
      "Download one exact expected asset",
      "Verify ciphertext SHA256",
      "Decrypt existing RSA-OAEP-SHA256/OpenPGP AES256 with accepted public fingerprint",
      "Verify plaintext SHA256 and exact canonical package",
      "Validate identity/segment/rows and reconcile manifest",
      "Reduce only structural fields",
      "Discard plaintext and crypto temp files, including on exceptions",
      "Repeat all100 in segment-major shard order, preserve MASTER output order",
      "Atomically emit compact result only after all100 and total-row reconciliation"
