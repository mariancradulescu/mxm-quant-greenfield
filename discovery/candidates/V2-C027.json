    },
    {
      "name": "current_30m_return",
      "formula": "current completed close / close 6 M5 bars earlier - 1"
    },
    {
      "name": "prior_30m_abs_return_scale",
      "formula": "median absolute 30m return across 24 non-overlapping fully completed 30m observations before current signal"
    },
    {
      "name": "breakout_direction",
      "formula": "LONG when current completed close > prior 6h high; SHORT when current completed close < prior 6h low"
    }
  ],
  "lookbacks": [
