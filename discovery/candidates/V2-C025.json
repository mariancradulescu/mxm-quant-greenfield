{
  "id": "V2-C025",
  "mechanism": {
    "family": "CAUSAL_ML_PREDICTIVE_OR_STATE_MODEL",
    "subfamily": "ROLLING_FINITE_STATE_COST_HURDLED_FORWARD_RETURN_MODEL"
  },
  "rationale": "Prospectively test an adaptive causal finite-state predictor rather than a fixed directional rule. Each market learns only from its own trailing four calendar weeks of fully realized prior examples; a state is tradable only when the one-standard-error lower confidence bound on expected 15-minute absolute return exceeds the frozen roundtrip cost. This directly targets realizable net edge and adaptation without protected data, random shuffle, or post-outcome tuning.",
  "universe": [
    "USDJPY",
    "GBPUSD",
    "USDCHF",
    "AUDUSD",
    "US500",
    "US2000",
    "SpotCrude",
    "SpotBrent",
    "ETHUSD",
    "Copper"
  ],
  "features": [
    {
      "name": "return_1_sign",
      "formula": "sign(close_t / close_t_minus_1 - 1)"
    },
    {
      "name": "return_3_sign",
      "formula": "sign(close_t / close_t_minus_3 - 1)"
    },
    {
      "name": "return_12_sign",
      "formula": "sign(close_t / close_t_minus_12 - 1)"
    },
    {
      "name": "volatility_state",
      "formula": "HIGH if abs(return_3_t) > median(abs(return_3_j)) over prior 144 completed observations else LOW"
    },
    {
      "name": "utc_session_bucket",
      "formula": "ASIA_00_08, EUROPE_08_14, US_14_21, LATE_21_24 by decision completion UTC"
    },
    {
      "name": "state_expected_forward_return",
      "formula": "mean of realized next-entry-open to third-M5-close returns for matching state in trailing 28 calendar days whose exits completed before current decision"
    },
    {
      "name": "state_standard_error",
      "formula": "sample standard deviation / sqrt(n) over the same matching-state prior examples"
    }
  ],
  "lookbacks": [
    {
      "feature": "return_12_sign",
      "bars": 12
    },
    {
      "feature": "prior_volatility_median",
      "observations": 144
    },
    {
      "feature": "state_training_window",
      "calendar_days": 28
    }
  ],
  "normalization_training": {
    "mode": "CAUSAL_ROLLING_FINITE_STATE",
    "future_normalization": false,
    "training_window_calendar_days": 28,
    "retraining_schedule": "EVERY_ELIGIBLE_15_MINUTE_DECISION",
    "inner_validation": "NONE_FIXED_STATE_MODEL",
    "random_temporal_shuffle": false,
    "purge_embargo": "EXAMPLES_ADMITTED_ONLY_AFTER_THEIR_TARGET_EXIT_COMPLETES"
  },
  "timing": {
    "decision": "EACH_COMPLETED_M5_CLOSE_AT_15_MINUTE_BOUNDARY",
    "entry": "NEXT_EXACT_OBSERVED_M5_OPEN",
    "target_horizon": "THREE_CONTIGUOUS_M5_BARS_FROM_ENTRY",
    "exit": "CLOSE_OF_THIRD_CONTIGUOUS_M5_BAR_INCLUDING_ENTRY"
  },
  "direction": {
    "LONG": "state_expected_forward_return > 0 and abs(mean)-standard_error > frozen_roundtrip_cost_fraction",
    "SHORT": "state_expected_forward_return < 0 and abs(mean)-standard_error > frozen_roundtrip_cost_fraction",
    "NO_OP": "insufficient_completed_state_examples_or_cost_hurdle_not_met"
  },
  "entry": {
    "type": "PER_SYMBOL_MARKET_PROXY",
    "price": "next_exact_observed_M5_open"
  },
  "exit": {
    "type": "FROZEN_TARGET_HORIZON",
    "price": "close_of_3rd_contiguous_M5_bar_including_entry"
  },
  "maximum_hold": {
    "unit": "CONTIGUOUS_M5_BARS_INCLUDING_ENTRY",
    "value": 3
  },
  "filters": [
    "DECISION_ONLY_AT_15_MINUTE_BOUNDARY",
    "CURRENT_AND_FEATURE_BARS_CONTIGUOUS",
    "TRAINING_EXAMPLES_TARGET_EXIT_MUST_PRECEDE_CURRENT_DECISION",
    "AT_LEAST_2_MATCHING_STATE_TRAINING_EXAMPLES_FOR_STANDARD_ERROR",
    "FROZEN_COARSE_COST_HURDLE_REQUIRED"
  ],
  "parameters": {
