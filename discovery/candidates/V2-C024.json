{
  "id": "V2-C024",
  "mechanism": {
    "family": "CROSS_SECTIONAL_RANKING",
    "subfamily": "CROSS_MARKET_15M_VOL_NORMALIZED_RESIDUAL_REVERSION_DYNAMIC_EXIT"
  },
  "rationale": "Prospectively test whether the most idiosyncratic short-horizon move across the accepted broker-native frontier mean-reverts after removing each market\u2019s own recent volatility scale and the contemporaneous cross-sectional median. This changes both information structure and exit law relative to earlier absolute-sign and 4h continuation candidates; no threshold/lookback grid is used.",
  "universe": [
    "USDJPY",
    "GBPUSD",
    "USDCHF",
    "AUDUSD",
    "US500",
    "US2000",
    "SpotCrude",
    "SpotBrent",
    "ETHUSD",
    "Copper"
  ],
  "features": [
    {
      "name": "return_3",
      "formula": "close_t / close_t_minus_3 - 1"
    },
    {
      "name": "prior_median_abs_return_3_36",
      "formula": "median(abs(return_3_j)) over exactly prior 36 completed M5 observations, excluding current"
    },
    {
      "name": "vol_normalized_return",
      "formula": "return_3 / prior_median_abs_return_3_36"
    },
    {
      "name": "cross_sectional_residual",
      "formula": "vol_normalized_return - median(vol_normalized_return across currently eligible markets)"
    },
    {
      "name": "selection_score",
      "formula": "abs(cross_sectional_residual) / frozen_roundtrip_cost_fraction"
    }
  ],
  "lookbacks": [
    {
      "feature": "return_3",
      "bars": 3
    },
    {
      "feature": "prior_median_abs_return_3_36",
      "observations": 36
    }
  ],
  "normalization_training": {
    "mode": "ROLLING_PRIOR_ONLY_MEDIAN_ABSOLUTE_RETURN",
    "future_normalization": false,
    "window_observations": 36,
    "cross_sectional_centering": "CURRENT_COMPLETED_BAR_ELIGIBLE_MARKETS_ONLY"
  },
  "timing": {
    "decision": "EACH_COMPLETED_M5_CLOSE_AT_15_MINUTE_BOUNDARY",
    "entry": "NEXT_EXACT_OBSERVED_M5_OPEN",
    "exit_decision": "FIRST_COMPLETED_M5_CLOSE_WHERE_SELECTED_SYMBOL_RESIDUAL_REACHES_OR_CROSSES_ZERO; OTHERWISE MAXIMUM_HOLD"
  },
  "direction": {
