{
  "id": "V2-C028",
  "mechanism": {
    "family": "CROSS_MARKET_LEAD_LAG",
    "subfamily": "CAUSAL_STRUCTURAL_LEADER_SHOCK_TO_LAGGARD_60M_COST_HURDLED"
  },
  "rationale": "Prospectively test cross-market information transfer instead of recurring same-symbol drift. Two economically structural leader-laggard relationships are frozen ex ante: US500 to US2000 and SpotCrude to SpotBrent. A laggard trade is allowed only after a large causal leader 30-minute shock and only when fully realized prior same-direction shocks over 28 days show a one-standard-error aligned 60-minute laggard expectation above the frozen laggard roundtrip cost. No C026 winning symbol/direction subset is reused.",
  "universe": [
    "USDJPY",
    "GBPUSD",
    "USDCHF",
    "AUDUSD",
    "US500",
    "US2000",
    "SpotCrude",
    "SpotBrent",
    "ETHUSD",
    "Copper"
  ],
  "features": [
    {
      "name": "leader_30m_return",
      "formula": "leader completed close / leader close 6 M5 bars earlier - 1 at each 15m decision"
    },
    {
      "name": "leader_shock_scale",
      "formula": "median absolute leader 30m return across prior 96 fully completed 15m decision observations"
    },
    {
      "name": "leader_shock_score",
      "formula": "abs(current leader 30m return) / causal prior median absolute leader 30m return"
    },
    {
      "name": "aligned_laggard_60m_return",
      "formula": "sign(leader_shock) * (laggard exact open at +60m / laggard exact entry open - 1) for fully realized prior shocks"
    },
    {
      "name": "causal_expected_aligned_lag",
      "formula": "mean and one-standard-error lower bound over trailing 28 calendar days of fully realized prior same-direction shock examples"
    }
  ],
  "lookbacks": [
    {
      "feature": "leader_shock_scale",
      "decision_observations": 96
    },
    {
      "feature": "aligned_lag_training",
      "calendar_days": 28
    },
    {
      "feature": "minimum_same_direction_examples",
      "count": 8
    }
  ],
  "normalization_training": {
