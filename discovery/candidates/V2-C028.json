    "future_normalization": false,
    "training_window_calendar_days": 28,
    "retraining_schedule": "EACH_15_MINUTE_LEADER_DECISION",
    "inner_validation": "NONE_FIXED_PAIR_MODEL",
    "random_temporal_shuffle": false,
    "purge_embargo": "TRAINING_EXAMPLE_ADMITTED_ONLY_AT_OR_AFTER_ITS_EXACT_60M_EXIT_OPEN"
  },
  "timing": {
