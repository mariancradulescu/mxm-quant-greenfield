{
  "id": "V2-C026",
  "mechanism": {
    "family": "SEASONALITY_SESSION_TIME",
    "subfamily": "CAUSAL_ROLLING_UTC_SEGMENT_DRIFT_COST_HURDLED"
  },
  "rationale": "Prospectively test a low-churn session-time drift mechanism after Wave02 showed that short-horizon adaptive activity did not clear conservative roundtrip friction. The candidate estimates each symbol's recurring return over four structurally defined UTC liquidity segments using only fully realized prior same-segment examples, and trades only when a one-standard-error lower bound on absolute expected segment return exceeds the frozen roundtrip cost. The segment structure and cost hurdle are frozen before C026's own outcome; no C024/C025 parameter rescue or protected evidence is used.",
  "universe": [
    "USDJPY",
    "GBPUSD",
    "USDCHF",
    "AUDUSD",
    "US500",
    "US2000",
    "SpotCrude",
    "SpotBrent",
    "ETHUSD",
    "Copper"
  ],
  "features": [
    {
      "name": "utc_liquidity_segment",
      "formula": "SEG_00_08, SEG_08_14, SEG_14_21, SEG_21_00 from exact UTC entry boundary to next exact UTC boundary"
    },
    {
      "name": "same_segment_forward_return",
      "formula": "exact observed M5 open at segment end / exact observed M5 open at segment start - 1"
    },
    {
      "name": "segment_expected_return",
      "formula": "mean of fully realized prior same-symbol same-segment returns whose exits completed before current entry, limited to trailing 28 calendar days"
    },
    {
      "name": "segment_standard_error",
      "formula": "sample standard deviation / sqrt(n) over the same causal training examples"
    }
  ],
  "lookbacks": [
    {
      "feature": "segment_training_window",
      "calendar_days": 28
    },
    {
      "feature": "minimum_completed_same_segment_examples",
      "count": 5
    }
  ],
  "normalization_training": {
    "mode": "CAUSAL_ROLLING_SAME_SEGMENT_EXPECTED_RETURN",
    "future_normalization": false,
    "training_window_calendar_days": 28,
    "retraining_schedule": "EACH_EXACT_UTC_SEGMENT_ENTRY_BOUNDARY",
    "inner_validation": "NONE_FIXED_SESSION_TIME_MODEL",
    "random_temporal_shuffle": false,
    "purge_embargo": "TRAINING_EXAMPLE_ADMITTED_ONLY_AFTER_ITS_SEGMENT_EXIT_HAS_COMPLETED"
  },
  "timing": {
    "decision": "EXACT_OBSERVED_M5_OPEN_AT_UTC_00_00_08_00_14_00_21_00_BOUNDARIES",
    "entry": "SAME_EXACT_OBSERVED_M5_OPEN_AT_DECISION_BOUNDARY",
    "target_horizon": "CURRENT_UTC_LIQUIDITY_SEGMENT_UNTIL_NEXT_FROZEN_BOUNDARY",
    "exit": "EXACT_OBSERVED_M5_OPEN_AT_NEXT_SEGMENT_BOUNDARY"
  },
  "direction": {
    "LONG": "segment_expected_return > 0 and abs(mean)-standard_error > frozen_roundtrip_cost_fraction",
    "SHORT": "segment_expected_return < 0 and abs(mean)-standard_error > frozen_roundtrip_cost_fraction",
    "NO_OP": "boundary_missing_or_exit_boundary_missing_or_insufficient_completed_same_segment_examples_or_cost_hurdle_not_met"
  },
  "entry": {
    "type": "PER_SYMBOL_SESSION_TIME_MARKET_PROXY",
    "price": "exact_observed_M5_open_at_current_segment_boundary"
  },
  "exit": {
