{
  "schema": "mxm.greenfield.parameter-discovery-and-robustness-governor.v1",
  "status": "ACTIVE_PROSPECTIVE_POLICY",
  "created_utc": "2026-09-28T08:42:00Z",
  "purpose": "Discover economically meaningful, statistically stable DEVELOPMENT parameter regions before confirmatory freeze without blind winner mining.",
  "governed_categories": [
    "resolution",
    "feature_horizon",
    "lookback",
    "event_definition",
    "threshold_or_trigger_strength",
    "volatility_normalization",
    "entry_delay",
    "holding_horizon",
    "exit_family",
    "regime_context",
    "session_window",
    "peer_scope_or_basket_construction",
    "retraining_frequency_for_ml",
    "regularization_or_model_complexity_for_ml"
  ],
  "prospective_search_space_requirements": {
    "economically_mechanistically_defensible_ranges": true,
    "ranges_frozen_before_development_surface": true,
    "no_ranges_created_after_observing_winner": true,
    "coarse_representations_first": true,
    "refine_only_after_broad_stable_region": true,
    "effective_material_trials_recorded": true,
    "all_evaluated_points_or_regions_recorded": true,
    "blind_large_cartesian_grids": false,
    "threshold_spam": false,
    "winner_only_logging": false
  },
  "stages": [
    {
      "stage": 1,
      "name": "COARSE_MECHANISM_REGION_SCAN",
      "rule": "Small diverse prospectively defined materially separated regions characterize the response surface."
    },
    {
      "stage": 2,
      "name": "ROBUST_REGION_IDENTIFICATION",
      "prefer": [
        "broad_positive_neighborhood",
        "adjacent_parameter_stability",
        "chronological_stability",
        "regime_stability",
        "adequate_event_density",
        "cost_headroom",
        "capital_efficiency"
      ],
      "reject": [
        "isolated_single_cell_winner",
        "one_exact_threshold_dependency",
        "one_exact_bar_count_dependency",
        "one_short_segment_dependency",
        "minimal_realistic_friction_collapse"
      ]
    },
    {
      "stage": 3,
      "name": "BOUNDED_LOCAL_REFINEMENT",
      "allowed_only_if": [
        "robust_coarse_region_exists",
        "refinement_predeclared",
        "protected_evidence_not_inspected"
      ],
      "objective": "Estimate stable operating region, not maximize a single backtest point."
    },
    {
      "stage": 4,
      "name": "PARAMETER_SELECTION_FREEZE",
      "freeze": [
        "final_parameter_selection_rule",
        "operating_point_or_robust_range",
        "tie_break_law",
        "entry_exit_semantics",
        "universe",
        "cost_assumptions",
        "validation_design"
      ]
    },
    {
      "stage": 5,
      "name": "CONFIRMATORY_VALIDATION",
      "requirements": [
        "temporally_separated_validation",
        "walk_forward_or_blocked_as_scientifically_appropriate",
        "dependence_aware_inference",
        "selection_aware_multiplicity_control",
        "parameter_choice_immutable_after_confirmatory_outcome"
      ]
    }
  ],
  "robustness_metrics": [
    "neighborhood_consistency",
    "effect_size",
    "uncertainty",
    "effective_sample_size",
    "event_density",
    "chronological_stability",
    "regime_stability",
    "symbol_or_cohort_breadth",
    "cost_headroom",
    "turnover",
    "capital_occupancy",
    "margin_efficiency"
  ],
  "no_single_parameter_family_rejection": {
    "enabled": true,
    "rule": "No family or asset/mechanism frontier receives exhaustion authority from one arbitrary parameter point unless that exact point is scientifically the complete mechanism."
  },
  "development_confirmation_boundary": {
    "development_permitted": [
      "mechanism_exploration",
      "bounded_parameter_region_exploration",
      "feature_selection_under_declared_rules",
      "coarse_to_fine_search",
      "response_surface_characterization",
      "robustness_diagnostics"
    ],
    "development_prohibited": [
      "claim_independent_confirmation",
      "use_protected_future_evidence",
      "hide_failed_parameter_probes",
      "repeatedly_modify_same_candidate_after_economic_outcome"
    ],
    "confirmation_requires": [
      "mechanism_and_selection_procedure_frozen",
      "operating_region_or_rule_frozen",
      "independent_temporal_evidence_where_required",
      "no_post_outcome_rescue",
      "multiplicity_and_selection_burden_accounted"
    ]
  },
  "data_reuse_law": {
    "valid_development_data_reusable_for_genuinely_new_development_questions": true,
    "negative_strategy_result_contaminates_valid_raw_market_data": false,
    "reused_development_data_can_be_called_untouched_confirmation": false,
    "protected_or_forward_evidence_permitted_for_parameter_discovery": false,
    "unnecessary_recapture_of_valid_bytes": false
  },
  "evidence_authority": {
    "exact_specification_null_family_exhaustion": false,
    "local_parameter_region_null_family_exhaustion": false,
    "low_power_null_family_exhaustion": false,
    "data_insufficient_family_exhaustion": false,
    "cost_or_realizability_rejection_family_exhaustion": false,
    "mechanism_region_supported_promotion_authority": true,
    "adequately_explored_frontier_null_scope": "LOCAL_FRONTIER_ONLY",
    "family_level_null_requires_explicit_closure_audit": true
  },
  "core_rule": "ROBUST_PARAMETER_REGION_MORE_VALUABLE_THAN_MAXIMUM_SINGLE_BACKTEST_POINT",
  "accounting_effect": {
    "economic_outcomes_opened": 0,
    "v2_attempts_used_delta": 0,
    "v2_search_budget_delta": 0
  }
}
