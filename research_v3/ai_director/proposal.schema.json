{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mxm.greenfield.general-ai-research-proposal.v1",
  "title": "MXM General AI Research Proposal",
  "description": "Provider-neutral free-form AI research reasoning envelope. Objective class is intentionally not an enum.",
  "type": "object",
  "required": [
    "schema",
    "proposal_id",
    "provider",
    "basis",
    "objective",
    "decision",
    "next_research_state",
    "authority_refs",
    "economic_effect",
    "safety",
    "scope_law",
    "data_policy",
    "causal_contract",
    "publication"
  ],
  "properties": {
    "schema": {
      "const": "mxm.greenfield.general-ai-research-proposal.v1"
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": true,
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": true
    },
    "objective": {
      "type": "object",
      "required": [
        "class",
        "goal",
        "information_gain_rationale"
      ],
      "additionalProperties": true,
      "properties": {
        "class": {
          "type": "string",
          "minLength": 1
        },
        "goal": {
          "type": "string",
          "minLength": 1
        },
        "information_gain_rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": true
    },
    "next_research_state": {
      "type": "object",
      "additionalProperties": true
    },
    "authority_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_attestation_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "data_bindings": {
      "type": "array",
      "items": {}
    },
    "economic_effect": {
      "type": "object",
      "required": [
        "open_economic_outcome",
        "consume_v2_attempt",
        "create_new_v2_identity"
      ],
      "properties": {
        "open_economic_outcome": {
          "const": false
        },
        "consume_v2_attempt": {
          "const": 0
        },
        "create_new_v2_identity": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "safety": {
      "type": "object",
      "required": [
        "protected_forward_opened",
        "live_orders_authorized",
        "competition_start_authorized"
      ],
      "properties": {
        "protected_forward_opened": {
          "const": false
        },
        "live_orders_authorized": {
          "const": false
        },
        "competition_start_authorized": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "scope_law": {
      "type": "object",
      "additionalProperties": true
    },
    "data_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "causal_contract": {
      "type": "object",
      "additionalProperties": true
    },
    "publication": {
      "type": "object",
      "required": [
        "apply_to_next_state"
      ],
      "properties": {
        "apply_to_next_state": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "acceptance_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
