      "cost (deferred)",
      "EUR200 margin feasibility (already known per feature store)",
      "breadth (frozen at 41, not outcome-selected)",
      "exact-head CI"
    ],
    "mechanism_definition": {
      "base_event_law": "Reuse the existing frozen BREAKOUT_VOLATILITY_EXPANSION event identification law already applied to produce accepted event counts per representative (e.g. CXMT.CN-PERP 911, ERICB.SE 319, XAUUSD-F 893) — no redefinition of the base trigger.",
